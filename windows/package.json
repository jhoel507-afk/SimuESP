{
  "name": "simuesp-studio",
  "version": "2.4.0",
  "description": "SimuESP Studio - simulador de electrónica para placas ESP32",
  "author": "SimuESP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.simuesp.studio",
    "productName": "SimuESP Studio",
    "files": ["main.js", "index.html", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "SimuESP-Studio-Instalador-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SimuESP-Studio-Portable-${version}.${ext}"
    }
  }
}
